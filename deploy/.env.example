# copy to deploy/.env (chmod 600). Never commit .env.
BRIDGE_TOKEN=change-me-long-random
ICLOUD_APPLE_ID=
# Safety (plan section 6). Whitelist stays on until M5.
BRIDGE_WRITE_WHITELIST=true
BRIDGE_READ_ONLY=false
BRIDGE_TEST_PREFIX=__bridge_test_
BRIDGE_ARCHIVE_NAME=__bridge_test_归档
BRIDGE_SHOW_SMART_ALBUMS=true
BRIDGE_SYNC_INTERVAL=300
# Decided by M0 item 4: isDeleted | forceDelete
BRIDGE_RELATION_REMOVE_MODE=isDeleted
